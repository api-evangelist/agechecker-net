{
  "opencollection": "1.0.0",
  "info": {
    "name": "AgeChecker.Net Age Verification Sessions Webhooks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "AgeChecker.Net Configure Webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.agechecker.net/v1/webhook",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Configure a webhook URL to receive verification result notifications."
        }
      ]
    }
  ],
  "bundled": true
}